{
  "appId": "com.abaccotech.saloraglam",
  "appName": "SALORA GLAM",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#fbf5f2",
      "showSpinner": false,
      "launchShowDuration": 0
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#ffffff"
    }
  },
  "ios": {
    "contentInset": "never",
    "scheme": "Salora Glam",
    "backgroundColor": "#fbf5f2",
    "limitsNavigationsToAppBoundDomains": false
  }
}